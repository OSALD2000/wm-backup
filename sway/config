workspace 23:i3 output $mon_m
workspace 24:i4 output $mon_m
workspace 25:i5 output $mon_m
workspace 26:i6 output $mon_m
workspace 27:i7 output $mon_m
workspace 28:i8 output $mon_m
workspace 29:i9 output $mon_m
workspace 30:i10 output $mon_m

# o: Laptop rechts
workspace 31:o1 output $mon_r
workspace 32:o2 output $mon_r
workspace 33:o3 output $mon_r
workspace 34:o4 output $mon_r
workspace 35:o5 output $mon_r
workspace 36:o6 output $mon_r
