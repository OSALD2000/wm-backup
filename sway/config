# sway config — Port von ~/.config/i3/config
# Ultra minimal — white/grey palette, clean bar
#
# Sway liest diese Datei statt ~/.config/i3/config. Die i3-Config bleibt
# unangetastet und weiter funktionsfaehig: Rollback = am GDM-Anmeldebildschirm
# Session "i3" waehlen.

# Diese Schrift traegt nur die Tab-Titel im tabbed/stacked-Layout. Die Titel
# stehen links in der eww-Fensterliste und oben in waybar (sway/window), die
# Tab-Zeile ist deshalb auf einen Streifen geschrumpft: winzige Schrift, leerer
# Titel. Sway kann sie bei tabbed nicht ganz abschalten, ~3px bleiben.
font pango:Iosevka Nerd Font 1
titlebar_padding 1
titlebar_border_thickness 0
for_window [all] title_format " "

# ── Input ─────────────────────────────────────────────────────────────────────
# Kommt unter X11 aus /etc/default/keyboard, das liest Sway nicht. Ohne diesen
# Block laeuft jede Tastatur auf us.
input type:keyboard {
    xkb_layout de
    xkb_options caps:escape
}

input type:touchpad {
    tap enabled
    natural_scroll disabled
}

# ── Environment ───────────────────────────────────────────────────────────────
# Sway kennt keine env-Direktive (das ist Hyprland). Die Wayland-/Qt-Vars stehen
# in ~/.config/environment.d/50-wayland.conf, systemd --user vererbt sie beim
# Login an die Session. Aenderungen dort brauchen ein Logout.

# ── Autostart ─────────────────────────────────────────────────────────────────
exec --no-startup-id dex --autostart --environment sway
# Monitore anordnen: dynamisch, egal wie viele angesteckt sind. Bei Dock-Wechsel
# mitten in der Session: $mod+Shift+s. exec_always, weil ein Reload ($mod+Shift+c)
# die per swaymsg gesetzten Positionen verwirft und Sway dann selbst anordnet.
exec_always --no-startup-id ~/.config/sway/scripts/screens.py
# xss-lock + i3lock -> swayidle + swaylock. before-sleep deckt ab, was
# --transfer-sleep-lock in i3 gemacht hat.
# Kein -i/--scaling hier: das steht in ~/.config/swaylock/config und gilt damit
# auch fuer den Ruf aus dem Power-Menue.
# lock.sh: hyprlock im HL2-Look, swaylock als Fallback.
# learn.py stop: Lern-Timer anhalten (bei Idle ohne die 10 Leerlauf-Minuten)
exec --no-startup-id swayidle -w \
    timeout 600 '/home/osa/.config/eww/scripts/learn.py stop --idle 600; ~/.config/sway/scripts/lock.sh' \
    before-sleep '/home/osa/.config/eww/scripts/learn.py stop; ~/.config/sway/scripts/lock.sh'
# nm-applet ist auf diesem System nicht installiert — die Zeile war schon in
# der i3-Config ein No-op. Wieder haben wollen:
#   sudo apt install network-manager-gnome
#   exec --no-startup-id nm-applet --indicator   (--indicator, sonst kein Tray)
exec --no-startup-id keepassxc
# swaync statt dunst: Verlauf, Nicht-Stoeren und ein Panel hinter der Glocke in
# der Bar — das GNOME-Gegenstueck. dunst hat keinen Verlauf. i3 behaelt dunst
# und sein dunstrc unveraendert.
#
# Das pkill davor ist kein Aberglaube: dunst und swaync streiten sich um
# org.freedesktop.Notifications auf dem D-Bus. Wer zuerst da ist, gewinnt, der
# zweite beendet sich still — und dann zeigt die Glocke in der Bar fuer immer
# "keine Benachrichtigungen", waehrend dunst sie im alten Blassgelb zustellt.
# Gilt auch nach dem Wechsel aus einer i3-Session ohne Neustart.
exec_always --no-startup-id "pkill -x dunst; pkill -x swaync; swaync"
# exec_always ohne pkill wuerde bei jedem $mod+Shift+c eine weitere waybar
# starten, bis drei uebereinander liegen.
exec_always --no-startup-id "pkill -x waybar; waybar"
exec_always --no-startup-id copyq

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
# picom entfaellt — Sway komponiert selbst. Die picom.conf machte nur Shadows,
# Fading und corner-radius, alle Opacity-Werte standen auf 1.0. Rein kosmetisch.
# xset s off / xset -dpms entfallen — Blanking regelt allein swayidle oben.

# ── Variables ─────────────────────────────────────────────────────────────────
set $mod Mod4
set $up l
set $down k
set $left j
set $right semicolon
set $private_shell /home/osa/Private/shell_scripts

# ── Colors — Nord ─────────────────────────────────────────────────────────────
# Dieselbe Palette wie waybar, rofi, swaync, swaylock und Alacritty-nord.
# i3 behaelt sein Grau; die Werte hier gelten nur fuer die Sway-Session.
set $nord0  #2E3440
set $nord1  #3B4252
set $nord2  #434C5E
set $nord3  #4C566A
set $nord4  #D8DEE9
set $nord6  #ECEFF4
set $nord8  #88C0D0
set $nord11 #BF616A

# Warme Palette — dieselbe wie waybar, rofi und swaync. Die nord*-Werte
# darueber stehen nur noch als Referenz drin.
# Kontraste gegen den Grund #1C1A15: #E8E1CF 13.33:1, #A89B77 6.31:1,
# #8A8069 4.45:1, #C4553D 3.90:1.
set $warm         #A89B77
set $warm_ground  #1C1A15
set $warm_card    #343026
set $warm_line    #3A352C
set $warm_ink     #E8E1CF
set $warm_dim     #8A8069
set $warm_brick   #C4553D

# HL2-HUD (2004) — Rahmen zurueckhaltend: aktives Fenster in gedimmtem Gelb
# (FgColor 255 220 0 @ 39% auf dunklem Grund), rot = DamagedBg 180 0 0.
# Die warm_*-Werte darueber sind der Vorgaenger.
set $hl2_bright   #FFDC00
set $hl2_edge     #74660D
set $hl2_dim      #8C7A1E
set $hl2_line     #2A2719
set $hl2_ground   #141310
set $hl2_dmg      #B40000

set $black        $hl2_ground
set $dark         $hl2_line
set $border_act   $hl2_edge
set $border_inact $hl2_line
set $text         $hl2_bright
set $text_dim     $hl2_dim
set $urgent       $hl2_dmg

# ── Wallpaper ─────────────────────────────────────────────────────────────────
# native Direktive statt feh; kein separater swaybg-exec noetig
output * bg /home/osa/Private/wallpaper.jpg fill

# ── Window Borders ────────────────────────────────────────────────────────────
# i3 hatte hier for_window [class="^.*"] border pixel 1 — ein class-Match
# greift bei nativen Wayland-Fenstern gar nicht, also die echten Defaults:
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders both
smart_borders on

# border/background/text faerben nur die Tab-Zeile -> alles $black, damit der
# geschrumpfte Streifen (siehe font oben) im Hintergrund verschwindet. Der
# Fensterrahmen haengt allein an child_border.
# border          background  text       indicator     child_border
client.focused          $black        $black  $black     $border_act   $border_act
client.unfocused        $black        $black  $black     $border_inact $border_inact
client.focused_inactive $black        $black  $black     $border_inact $border_inact
client.urgent           $urgent       $urgent $text      $urgent       $urgent

# ── Gaps ──────────────────────────────────────────────────────────────────────
gaps inner 10
gaps outer 2
smart_gaps on

# ── Volume / Brightness ───────────────────────────────────────────────────────
# $refresh_i3status entfaellt: waybar bekommt Pegel und Helligkeit ueber
# PipeWire bzw. sysfs selbst mit, es gibt nichts anzustossen.
bindsym XF86AudioRaiseVolume  exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5% && $HOME/Private/shell_scripts/volume_script.sh
bindsym XF86AudioLowerVolume  exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5% && $HOME/Private/shell_scripts/volume_script.sh
bindsym XF86AudioMute         exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioMicMute      exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86MonBrightnessUp   exec --no-startup-id /usr/bin/brightnessctl set 25+
bindsym XF86MonBrightnessDown exec --no-startup-id /usr/bin/brightnessctl set 25-

# ── Screenshot ────────────────────────────────────────────────────────────────
# nur der fokussierte Monitor (~/.local/bin/shot-wl); grim/slurp statt scrot/xclip
bindsym Print       exec --no-startup-id ~/.local/bin/shot-wl
bindsym Ctrl+Print  exec --no-startup-id ~/.local/bin/shot-wl clip
bindsym Shift+Print exec --no-startup-id grim -g "$(slurp)" - | wl-copy

# ── Window Management ─────────────────────────────────────────────────────────
tiling_drag enable
bindsym $mod+Return      exec alacritty
bindsym $mod+Shift+q     kill
bindsym $mod+d           exec "rofi -config ~/.config/rofi/config-nord.rasi -modi drun,run -show drun"

bindsym $mod+$left  focus left
bindsym $mod+$down  focus down
bindsym $mod+$up    focus up
bindsym $mod+$right focus right
bindsym $mod+Left   focus left
bindsym $mod+Down   focus down
bindsym $mod+Up     focus up
bindsym $mod+Right  focus right
# q laeuft im Kreis durch die Fensterliste links (sichtbarer Workspace dieses
# Monitors). Nicht `focus next`: das springt am Ende auf den Nachbarmonitor.
bindsym $mod+q      exec ~/.config/eww/scripts/sidebar.py next
bindsym $mod+Ctrl+q exec ~/.config/eww/scripts/sidebar.py prev
# Fensterliste links an/aus. Nicht Super+Shift_R: das faellt bei jedem
# Super+Shift+N mit.
bindsym $mod+b      exec ~/.config/eww/scripts/sidebar.py toggle

bindsym $mod+Shift+$left  move left
bindsym $mod+Shift+$down  move down
bindsym $mod+Shift+$up    move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left   move left
bindsym $mod+Shift+Down   move down
bindsym $mod+Shift+Up     move up
bindsym $mod+Shift+Right  move right

bindsym $mod+h          split h
bindsym $mod+v          split v
bindsym $mod+f          fullscreen toggle
# Neue Workspaces starten tabbed: ein Fenster gross, die Liste links zeigt die
# anderen. Die Tab-Zeile selbst ist unsichtbar (siehe font/title_format oben).
workspace_layout tabbed
# kein $mod+s (stacking): das zeichnet eine Titelzeile je Fenster, die
# Fensterliste links ersetzt es
bindsym $mod+w          layout tabbed
bindsym $mod+e          layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space      focus mode_toggle
bindsym $mod+a          focus parent

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus       scratchpad show

# ── Workspaces ────────────────────────────────────────────────────────────────
# Jeder Monitor hat eigene 1-10, gleiches Raster ueberall:
#   1 Terminal  2 Browser  3 Code  4 Code 2  5 Trading  6 frei
#   7 Tools     8 Todos    9 Chat  10 Medien
# Kuerzel nach Position, nicht nach Anschluss: u = links, i = mitte, o = Laptop.
# Name "<nr>:<kuerzel><N>": u = 11-20, i = 21-30, o = 31-40. Die Nummer haelt die
# Sortierung richtig, ws.sh rechnet daraus den Monitor zurueck.

# Jede Regel zweimal: class/instance greift bei XWayland-Fenstern, app_id bei
# nativen Wayland-Fenstern (dort ist class immer null).
# Nachpruefen mit: swaymsg -t get_tree | grep -E '"(app_id|class|instance)"'
assign [class="jetbrains-idea"]                                      24:i4
assign [app_id="jetbrains-idea"]                                     24:i4
assign [class="Code"]                                                23:i3
assign [app_id="code"]                                               23:i3
assign [class="KeePassXC"]                                           37:o7
assign [app_id="org.keepassxc.KeePassXC"]                            37:o7
assign [instance="crx_pkakhoojapanfmkoegaeonmdcmmcjfll"]             38:o8
assign [app_id="chrome-pkakhoojapanfmkoegaeonmdcmmcjfll-Profile_1"]  38:o8
assign [instance="crx_cifhbcnohmdccbgoicgdjpfamggdegmo"]             39:o9
assign [app_id="chrome-cifhbcnohmdccbgoicgdjpfamggdegmo-Profile_1"]  39:o9
assign [instance="crx_agimnkijcaahngcdmfeangaknmldooml"]             40:o10
assign [app_id="chrome-agimnkijcaahngcdmfeangaknmldooml-Profile_1"]  40:o10

# ── Workspace → Output ────────────────────────────────────────────────────────
# Fallback-Listen: Sway nimmt den ersten *aktiven* Output der Liste und wertet
# das bei Hotplug selbst neu aus. Deckt jeden Platz ab (links ist HDMI-A-1,
# DP-8 oder DP-9, je nach Dock) und faellt auf den Laptop zurueck, wenn nichts
# angesteckt ist. Reihenfolge = scripts/screens.py: extern absteigend, Laptop
# zuletzt.
# Achtung: unter X11 hiess der HDMI-Ausgang HDMI-1, Sway nutzt den
# DRM-Connector-Namen HDMI-A-1.
set $mon_l HDMI-A-1 DP-9 DP-8 DP-7 eDP-1
set $mon_m DP-7 DP-8 DP-9 HDMI-A-1 eDP-1
# $mon_r: Laptop zuerst. Faellt danach auf *links* zurueck, nicht auf die
# Mitte — wenn der Laptop aus ist ($mod+Ctrl+s), soll der Code-Schirm nicht
# zusaetzlich Teams und YouTube abbekommen.
set $mon_r eDP-1 HDMI-A-1 DP-9 DP-8 DP-7

# u: links
workspace 11:u1 output $mon_l
workspace 12:u2 output $mon_l
workspace 13:u3 output $mon_l
workspace 14:u4 output $mon_l
workspace 15:u5 output $mon_l
workspace 16:u6 output $mon_l
workspace 17:u7 output $mon_l
