# HL2-Lambda fuer cowsay: cowsay -f ~/.config/alacritty/lambda.cow "..."
# Aufruf aus ~/.zshrc beim Oeffnen von Alacritty, Farbe HUD-Gelb #FFDC00.
use utf8;  # sonst kodiert cowsay die Blockzeichen doppelt
$the_cow = <<"EOC";
   $thoughts
    $thoughts
    ▄▄▄▄▄▄▄
    ▀▀▀▀████
          ████
           ████
          ██████
         ███▀████
        ███  ████
       ███    ████
      ███      ████
     ███        ████▄▄▄
    ███          ▀██████
EOC
