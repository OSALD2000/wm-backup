      (label :class "section" :xalign 0 :text "APPS")
        (key :k "Super+Return" :d "Terminal")
        (key :k "Super+Shift+Tab" :d "Konsole (cool-retro-term ein/aus)")
        (key :k "Super+d" :d "Launcher")
