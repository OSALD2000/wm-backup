(deflisten learn
  :initial `{"running":false,"topic":"","elapsed":"","today":"0m","week":"0m","total":"0m","streak":0,"all_today":"0m","all_streak":0,"bars":[],"heat":[],"topics":[],"has_last":false,"suit":0}`
  "~/.config/eww/scripts/learn.py watch")
(defvar new_topic "")

; HL2-HUD: Ecken unten auf dem Laptop, unter den Fenstern -> sichtbar auf leerem Workspace
(defwidget hud [label value ?small ?warn]
  (box :class "hud ${warn == 'true' ? 'warn' : ''}" :space-evenly false :spacing 14
    (label :class "hud-label" :valign "end" :text label)
    (label :class "hud-num" :text value)
    (label :class "hud-small" :valign "end" :visible {small != ""} :text small)))

(defwindow hud-left
  :monitor "eDP-1"
  :geometry (geometry :x "32px" :y "32px" :anchor "bottom left")
  :stacking "bottom"
  :exclusive false
  :focusable false
  (box :space-evenly false :spacing 12
    (hud :label "HEALTH" :value {EWW_BATTERY.BAT0.capacity} :warn {EWW_BATTERY.BAT0.capacity < 20})
    (hud :label "SUIT" :value {learn.suit})))

(defwindow hud-right
  :monitor "eDP-1"
  :geometry (geometry :x "32px" :y "32px" :anchor "bottom right")
  :stacking "bottom"
  :exclusive false
  :focusable false
  (box :space-evenly false :spacing 12
  (button :class "hud-btn" :tooltip "Hilfe: Monitore und Shortcuts (Super+Shift+Z)" :onclick "eww open --toggle info"
    (box :class "hud info-btn" (label :class "hud-num" :text "?")))
  (button :class "hud-btn" :tooltip "Lern-Panel (Super+Z)" :onclick "eww open --toggle learn"
    (box :class "hud ammo ${learn.running ? 'on' : ''}" :space-evenly false :spacing 14
      (box :orientation "v" :space-evenly false :valign "end"
        (label :class "hud-label" :xalign 0 :text "🔥 ${learn.all_streak}")
        (label :class "hud-label" :xalign 0 :text {learn.topic == "" ? "AMMO" : learn.topic}))
      (label :class "hud-num" :text {learn.running ? learn.elapsed : "--"})
      (label :class "hud-small" :valign "end" :text {learn.all_today})))))

(defwidget stat [label value]
  (box :class "stat" :orientation "v" :space-evenly false
    (label :class "stat-value" :text value)
    (label :class "stat-label" :text label)))

(defwindow learn
  :monitor "eDP-1"
  :geometry (geometry :x "32px" :y "110px" :width "440px" :anchor "bottom right")  ; direkt ueber AMMO
  :stacking "overlay"   ; über den Fenstern, damit per Super+Z immer sichtbar
  :exclusive false
  :focusable "ondemand"
  (box :class "panel" :orientation "v" :space-evenly false :spacing 14
    (box :class "hero ${learn.running ? 'on' : ''}" :orientation "v" :space-evenly false :spacing 6
      (label :class "hero-topic" :text {learn.topic == "" ? "Lege unten ein Thema an" : learn.topic})
      (label :class "hero-time" :text {learn.running ? learn.elapsed : "0:00:00"})
      (box :halign "center" :space-evenly false :spacing 8
        (button :class "btn go" :visible {!learn.running && learn.topic != ""}
          :onclick "~/.config/eww/scripts/learn.py start '${learn.topic}'" "▶  Start")
        (button :class "btn stop" :visible {learn.running}
          :onclick "~/.config/eww/scripts/learn.py stop" "■  Stop")
        (button :class "btn ghost" :visible {learn.running} :tooltip "Laufende Session nicht zählen"
          :onclick "~/.config/eww/scripts/learn.py discard" "✕  Verwerfen")))
    (box :class "stats"
      (stat :label "Heute" :value {learn.today})
      (stat :label "Woche" :value {learn.week})
      (stat :label "Gesamt" :value {learn.total})
      (stat :label "Streak" :value "🔥 ${learn.streak}"))
    (box :class "chart" :spacing 6
      (for b in {learn.bars}
        (box :orientation "v" :space-evenly false :spacing 4 :tooltip {b.h}
          (progress :class "bar ${b.today ? 'today' : ''}" :orientation "v" :flipped true
            :halign "center" :value {b.pct})
          (label :class "bar-label" :text {b.d}))))
    (box :class "heat" :orientation "v" :space-evenly false :spacing 8
      (box :space-evenly false
        (label :class "section" :hexpand true :xalign 0 :text "Letzte 26 Wochen · alle Themen")
        (box :class "legend" :space-evenly false :spacing 3
          (label :class "muted small" :text "weniger ")
          (box :class "cell l0") (box :class "cell l1") (box :class "cell l2") (box :class "cell l3") (box :class "cell l4")
          (label :class "muted small" :text " mehr")))
      (box :halign "center" :space-evenly false :spacing 3
        (for w in {learn.heat}
          (box :orientation "v" :space-evenly false :spacing 3
            (for c in {w}
              (box :class "cell l${c.l}" :tooltip {c.t}))))))
    (box :class "topics" :orientation "v" :space-evenly false :spacing 4
      (for t in {learn.topics}
        (box :class "topic ${t.active ? 'active' : ''}" :space-evenly false
          (button :class "topic-btn" :hexpand true :tooltip "Start / Stop"
            :onclick "~/.config/eww/scripts/learn.py toggle '${t.name}'"
            (box :space-evenly false
              (label :xalign 0 :hexpand true :text "${t.active ? '● ' : ''}${t.name}")
              (label :class "muted" :text "${t.today} heute · ${t.total}")))
          (button :class "x" :tooltip "Archivieren (Stunden bleiben erhalten)"
            :onclick "~/.config/eww/scripts/learn.py archive '${t.name}'" "✕"))))
    (box :class "new" :space-evenly false :spacing 8
        (label :class "muted" :text "+")
        (input :hexpand true :value new_topic
          :onchange "eww update new_topic='{}'"
          :onaccept "~/.config/eww/scripts/learn.py add '{}' && eww update new_topic=''"))
    (box :class "footer" :space-evenly false
      (label :class "muted" :hexpand true :xalign 0
        :text "Alle Themen · heute ${learn.all_today} · 🔥 ${learn.all_streak} Tage")
      (button :class "btn ghost small" :visible {learn.has_last} :tooltip "Letzte gespeicherte Session löschen"
        :onclick "~/.config/eww/scripts/learn.py undo" "↶ Letzte Session"))))

; Fensterliste links, eine pro Monitor. sidebar.py watch fuellt wins per
; `eww update` und oeffnet/schliesst die Fenster (erst ab 2 Fenstern).
; Fenster des sichtbaren Workspaces; Klick fokussiert, Mittelklick schliesst, Mausrad sortiert.
; Super+q / Super+Ctrl+q laufen durch dieselbe Liste (sidebar.py next/prev).
(defvar wins "{}")

; stacking "bottom": Sway ordnet die exklusiven Flaechen Ebene fuer Ebene an,
; die waybar (Ebene top) also immer vor der Sidebar -> volle Breite oben, die
; Sidebar beginnt darunter. Auf "fg" gewinnt, wer zuerst startet.
(defwindow sidebar [screen height]
  :monitor screen
  :geometry (geometry :width "58px" :height height :anchor "center left")
  :stacking "bottom"
  :exclusive true
  :focusable false
  (box :class "sidebar" :orientation "v" :space-evenly false :spacing 3
    (for w in {wins?.[screen] ?: []}
      ; Mausrad ueber einem Eintrag = Fenster hoch/runter (sidebar.py nudge).
      ; Kein Drag&Drop: eww 0.6 erlaubt Ablegen nur aus anderen Programmen.
      (eventbox :onscroll "~/.config/eww/scripts/sidebar.py nudge ${w.id} {}"
      (button :class "win ${w.focused ? 'active' : ''}" :tooltip {w.title}
              :onclick "swaymsg '[con_id=${w.id}] focus'"
              :onmiddleclick "swaymsg '[con_id=${w.id}] kill'"
        ; Icon ueber dem App-Namen, der Fenstertitel steht im Tooltip
        (box :orientation "v" :space-evenly false :spacing 2
          (image :path {w.icon} :image-width 16 :image-height 16)
          (label :class "win-app" :limit-width 8 :text {w.name})))))))

; Mission Control: JSON bleibt die Aufgabenquelle, Obsidian ergaenzt freie Notizen.
(deflisten missions
  :initial `{"open":0,"done":0,"focus":0,"archived":0,"progress":0,"groups":[[],[],[],[]],"error":""}`
  "~/.config/eww/scripts/todo.py watch")
(defvar mission_tab 1)

(defwidget mission-row [m]
  (box :class "ms-item ${m.focus ? 'focused' : ''} ${m.done ? 'done' : ''}"
    :orientation "v" :space-evenly false :spacing 8
    (box :space-evenly false :spacing 12
      (button :class "ms-check" :active {!m.archived}
        :tooltip {m.done ? "Wieder oeffnen" : "Erledigen"}
        :onclick "~/.config/eww/scripts/todo.py done ${m.id}"
        {m.done ? "✓" : "○"})
      (label :class "ms-text" :xalign 0 :yalign 0.5 :hexpand true
        :wrap true :wrap-mode "wordchar" :width 410 :text {m.text}))
    (box :class "ms-actions" :space-evenly false :spacing 6
      (button :class "ms-action ${m.focus ? 'selected' : ''}" :visible {!m.done && !m.archived}
        :tooltip "Bis zu drei Missionen fuer jetzt auswaehlen"
        :onclick "~/.config/eww/scripts/todo.py focus ${m.id}"
        {m.focus ? "★ Im Fokus" : "☆ Fokus"})
      (button :class "ms-action" :timeout "10m" :visible {!m.archived}
        :onclick "~/.config/eww/scripts/todo.py edit ${m.id}" "Bearbeiten")
      (button :class "ms-action" :timeout "5s" :tooltip "Eigene Notiz in Obsidian anlegen oder oeffnen"
        :onclick "~/.config/eww/scripts/todo.py note ${m.id}" "↗ Notiz")
      (box :hexpand true)
      (button :class "ms-action ms-archive" :tooltip "Bleibt gespeichert und kann zurueckgeholt werden"
        :onclick "~/.config/eww/scripts/todo.py archive ${m.id}"
        {m.archived ? "↶ Zurueckholen" : "Archivieren"}))))

(defwidget mission-list [group]
  (scroll :height 330 :vexpand true :hscroll false :vscroll true
    (box :orientation "v" :space-evenly false :spacing 8
      (box :class "ms-empty" :visible {arraylength(group) == 0} :orientation "v" :spacing 10
        (label :class "ms-empty-symbol" :text {mission_tab == 0 ? "◎" : "✓"})
        (label :class "ms-summary" :wrap true :text {mission_tab == 0 ? "Was ist jetzt wichtig?" : mission_tab == 1 ? "Freier Kopf. Alles erledigt." : mission_tab == 2 ? "Hier sammeln sich deine Erfolge." : "Dein Archiv ist leer."})
        (label :class "ms-subtitle" :wrap true :text {mission_tab == 0 ? "Markiere unter Offen bis zu drei Aufgaben mit ☆ Fokus." : "Alle Missionen bleiben gespeichert."}))
      (for m in group (mission-row :m m)))))

; Halbe Waybar-Hoehe (30px) ausgleichen: Mitte des gesamten Bildschirms.
(defwindow mission
  :monitor "eDP-1"
  :geometry (geometry :x "24px" :y "-15px" :width "560px" :height "80%" :anchor "center right")
  :stacking "overlay" :exclusive false :focusable "ondemand"
  (box :class "panel mission" :orientation "v" :space-evenly false :spacing 16
    (box :class "ms-head" :space-evenly false :spacing 14
      (label :class "ms-lambda" :text "λ")
      (box :orientation "v" :space-evenly false :spacing 3 :hexpand true
        (label :class "ms-title" :xalign 0 :text "Mission Control")
        (label :class "ms-subtitle" :xalign 0 :text "Platz fuer deinen naechsten Schritt."))
      (button :class "ms-action" :tooltip "Panel schliessen · Super+m"
        :onclick "eww close mission" "✕"))
    (box :orientation "v" :space-evenly false :spacing 8
      (box :space-evenly false
        (label :class "ms-summary" :hexpand true :xalign 0 :text "${missions.open} offen · ${missions.done} erledigt")
        (label :class "ms-subtitle" :text "${missions.focus}/3 im Fokus"))
      (progress :class "ms-progress" :value {missions.progress}))
    (box :class "ms-tabs" :space-evenly true :spacing 4
      (button :class "ms-tab ${mission_tab == 0 ? 'selected' : ''}" :onclick "eww update mission_tab=0" "Jetzt")
      (button :class "ms-tab ${mission_tab == 1 ? 'selected' : ''}" :onclick "eww update mission_tab=1" "Offen")
      (button :class "ms-tab ${mission_tab == 2 ? 'selected' : ''}" :onclick "eww update mission_tab=2" "Erledigt")
      (button :class "ms-tab ${mission_tab == 3 ? 'selected' : ''}" :onclick "eww update mission_tab=3" "Archiv"))
    (label :class "ms-error" :visible {missions.error != ""} :wrap true :text {missions.error})
    (stack :selected mission_tab :transition "crossfade" :same-size true :vexpand true
      (mission-list :group {missions.groups[0]})
      (mission-list :group {missions.groups[1]})
      (mission-list :group {missions.groups[2]})
      (mission-list :group {missions.groups[3]}))
    (button :class "ms-add" :timeout "10m" :onclick "~/.config/eww/scripts/todo.py new" "+ Neue Mission")
    (box :class "ms-foot" :orientation "v" :space-evenly false :spacing 5
      (label :class "ms-subtitle" :xalign 0 :text "↗ Notiz verbindet jede Mission mit Obsidian.")
      (label :class "ms-subtitle" :xalign 0 :text "Super+Ctrl+m  Schnell erfassen    ·    Super+m  Schliessen"))))

; Trading-Journal (Super+Ctrl+j): Formular statt Abfragen. journal.py setzt die
; jr_*-Variablen, macht den Screenshot und oeffnet das Fenster auf dem
; fokussierten Monitor. Knoepfe schicken nur Werte aus jr_opts (Indizes /
; feste Tokens), Speichern erst, wenn Datum/Zeit/R per Regex passen: nichts
; Freies landet in der Shell-Zeile. Die Notiz fragt journal.py danach per rofi.
(defvar jr_opts `{"last":"","last_open":false,"symbols":[],"models":[],"tfs":[],"results":[],"types":[],"dirs":[],"biases":[]}`)
(defvar jr_mode "new")
(defvar jr_type "live")
(defvar jr_date "")
(defvar jr_time "")
(defvar jr_sym 0)
(defvar jr_dir "")
(defvar jr_bias "")
(defvar jr_model 0)
(defvar jr_tf "5m")
(defvar jr_res "offen")
(defvar jr_r "")
(defvar jr_err "")

(defwidget jr-chips [items sel var]
  (box :class "ms-tabs" :space-evenly false :spacing 4
    (for it in items
      (button :class "ms-tab jr-chip ${sel == it.v ? 'selected' : ''}"
        :onclick "eww update ${var}=${it.v} jr_err=" {it.l}))))

(defwidget jr-row [label ?visible]
  (box :space-evenly false :spacing 12 :visible {visible ?: true}
    (label :class "jr-label" :xalign 0 :text label)
    (children)))

(defwindow journal
  :monitor "eDP-1"  ; journal.py setzt --screen auf den fokussierten Monitor
  :geometry (geometry :anchor "center" :width "640px")
  :stacking "overlay" :exclusive false :focusable "ondemand"
  (box :class "panel mission" :orientation "v" :space-evenly false :spacing 14
    (box :class "ms-head" :space-evenly false :spacing 14
      (label :class "ms-lambda" :text "λ")
      (box :orientation "v" :space-evenly false :spacing 3 :hexpand true
        (label :class "ms-title" :xalign 0 :text "Journal")
        (label :class "ms-subtitle" :xalign 0 :text "Screenshot ist gemacht. Setup beschreiben."))
      (button :class "ms-action" :tooltip "Verwerfen · Super+Ctrl+j"
        :onclick "~/.config/sway/scripts/journal.py cancel" "✕"))
    ; immer sichtbar, ohne letztes Setup ausgegraut
    (box :class "ms-tabs" :space-evenly true :spacing 4
      (button :class "ms-tab ${jr_mode == 'add' ? 'selected' : ''}" :active {jr_opts.last != ""}
        :tooltip "Weiterer Screenshot zum letzten Setup" :onclick "eww update jr_mode=add jr_time=${jr_opts.last_time} jr_err="
        (label :limit-width 44 :text {jr_opts.last != "" ? "+ zum letzten: ${jr_opts.last}" : "+ zum letzten (noch kein Setup)"}))
      (button :class "ms-tab ${jr_mode == 'new' ? 'selected' : ''}" :onclick "eww update jr_mode=new jr_time=${jr_opts.now_ny} jr_err=" "Neues Setup"))
    (jr-row :label "ART" :visible {jr_mode == 'new'}
      (jr-chips :items {jr_opts.types} :sel jr_type :var "jr_type"))
    ; Entry-Zeit auch beim letzten Setup, solange es offen ist
    (jr-row :label {jr_mode == 'new' ? "DATUM" : "ENTRY NY"} :visible {jr_mode == 'new' || jr_opts.last_open}
      (input :visible {jr_mode == 'new'} :class "jr-input ${jr_date =~ '^[0-9][0-9][.][0-9][0-9][.][0-9][0-9][0-9][0-9]$' ? '' : 'bad'}"
        :width 130 :value jr_date :onchange "eww update jr_date='{}'")
      (label :class "jr-label jr-gap" :visible {jr_mode == 'new'} :text "ENTRY NY")
      (input :class "jr-input ${(jr_time == '' || jr_time =~ '^[0-9]?[0-9]:?[0-9][0-9]$') ? '' : 'bad'}"
        :width 80 :value jr_time :onchange "eww update jr_time='{}'"))
    (jr-row :label "SYMBOL" :visible {jr_mode == 'new'}
      (jr-chips :items {jr_opts.symbols} :sel jr_sym :var "jr_sym"))
    (jr-row :label "RICHTUNG" :visible {jr_mode == 'new'}
      (jr-chips :items {jr_opts.dirs} :sel jr_dir :var "jr_dir")
      (label :class "ms-error jr-gap" :visible {jr_dir == ""} :text "Pflicht"))
    (jr-row :label "D-BIAS" :visible {jr_mode == 'new'}
      (jr-chips :items {jr_opts.biases} :sel jr_bias :var "jr_bias")
      (label :class "ms-error jr-gap" :visible {jr_bias == ""} :text "Pflicht"))
    (jr-row :label "MODEL" :visible {jr_mode == 'new'}
      (jr-chips :items {jr_opts.models} :sel jr_model :var "jr_model"))
    (jr-row :label "TIMEFRAME"
      (jr-chips :items {jr_opts.tfs} :sel jr_tf :var "jr_tf"))
    (jr-row :label "ERGEBNIS" :visible {jr_mode == 'new' || jr_opts.last_open}
      (jr-chips :items {jr_opts.results} :sel jr_res :var "jr_res")
      (label :class "jr-label jr-gap" :visible {jr_res != 'offen' && jr_res != 'notrade'} :text "R")
      (input :class "jr-input ${jr_r == '' || jr_r =~ '^-?[0-9]+([.,][0-9]+)?$' ? '' : 'bad'}"
        :visible {jr_res != 'offen' && jr_res != 'notrade'} :width 60 :value jr_r :onchange "eww update jr_r='{}'"))
    (label :class "ms-error" :visible {jr_err != ""} :xalign 0 :text jr_err)
    (button :class "ms-add" :timeout "10m"
      :active {(jr_r == '' || jr_r =~ '^-?[0-9]+([.,][0-9]+)?$') && (jr_time == '' || jr_time =~ '^[0-9]?[0-9]:?[0-9][0-9]$') && (jr_mode == 'add' || (jr_dir != '' && jr_bias != '' && jr_date =~ '^[0-9][0-9][.][0-9][0-9][.][0-9][0-9][0-9][0-9]$'))}
      :onclick "~/.config/sway/scripts/journal.py save ${jr_mode} ${jr_type} ${jr_date} '${jr_time}' ${jr_sym} ${jr_dir == '' ? '-' : jr_dir} ${jr_bias == '' ? '-' : jr_bias} ${jr_model} ${jr_tf} ${jr_res} '${jr_r}'"
      "Speichern  ·  danach Notiz")
    (label :class "ms-subtitle" :xalign 0 :text "Super+Ctrl+j  Verwerfen    ·    Datei je Setup unter Trading/journaling/")))

; Agenten (Super+c): laufende Claude-Code-/Codex-Sessions + Verlauf, nach Ordner.
; agents.py watch (exec_always) schreibt den Stand, follow liest ihn nur, solange
; das Fenster offen ist. Tasten kommen ueber den sway-Mode "[ AGENTS ]" (eww
; selbst kann keine Tasten), der setzt agent_sel per `eww update`.
(deflisten agents
  :initial `{"live":[],"hist":[],"count":0,"busy":0,"idle":0,"new":0,"n":0}`
  "~/.config/eww/scripts/agents.py follow")
(defvar agent_sel 0)

(defwidget agent-card [it]
  (button :class "ag-card ${it.status} ${it.new ? 'new' : ''} ${agent_sel == it.idx ? 'sel' : ''}"
          :onclick "~/.config/eww/scripts/agents.py go ${it.idx}"
    (box :orientation "v" :space-evenly false :spacing 3
      (box :space-evenly false :spacing 12
        (label :class "ag-tool" :text {it.tool == "claude" ? "λ CLAUDE" : "◆ CODEX"})
        (label :class "ag-name" :hexpand true :xalign 0 :limit-width 56 :text {it.name})
        (label :class "ag-status" :text {it.status == "busy" ? "⚙ ARBEITET" : "✓ BEREIT"}))
      (label :class "ag-prompt" :xalign 0 :limit-width 96 :visible {it.prompt != ""} :text "“${it.prompt}”")
      (box :space-evenly false :spacing 12
        (label :class "ag-action" :hexpand true :xalign 0 :limit-width 70 :text "› ${it.action}")
        (label :class "ag-meta" :text "${it.since}${it.tokens != '' ? ' · ' + it.tokens : ''}${it.ws != '' ? ' · ' + it.ws : ''}")))))

(defwidget agent-row [it]
  (button :class "ag-row ${agent_sel == it.idx ? 'sel' : ''}" :onclick "~/.config/eww/scripts/agents.py go ${it.idx}"
    (box :space-evenly false :spacing 12
      (label :class "ag-tool" :text {it.tool == "claude" ? "λ" : "◆"})
      (label :class "ag-name" :hexpand true :xalign 0 :limit-width 70 :text {it.name != "" ? it.name : it.prompt})
      (label :class "ag-meta" :text {it.ago}))))

(defwindow agents
  :monitor "eDP-1"  ; agents.py open setzt --screen auf den fokussierten Monitor
  :geometry (geometry :anchor "center" :width "780px")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (box :class "panel agents" :orientation "v" :space-evenly false :spacing 8
    (box :class "ms-head" :space-evenly false
      (label :class "ms-lambda" :text "λ")
      (box :orientation "v" :space-evenly false :hexpand true
        (label :class "ms-title" :xalign 0 :text "SQUAD STATUS")
        (label :class "muted small" :xalign 0
          :text "${agents.busy} arbeiten · ${agents.idle} bereit${agents.new > 0 ? ' · ' + agents.new + ' neu' : ''}")))
    (label :class "muted" :visible {agents.n == 0} :xalign 0 :text "Keine laufenden Agenten.")
    (for g in {agents.live}
      (box :orientation "v" :space-evenly false :spacing 4
        (box :class "ag-group" :space-evenly false :spacing 10
          (label :class "ag-gname" :text "▸ ${g.name}")
          (label :class "muted small" :text {g.path}))
        (for it in {g.items} (agent-card :it it))))
    (label :class "section ag-hist" :xalign 0 :visible {arraylength(agents.hist) > 0} :text "VERLAUF")
    (for g in {agents.hist}
      (box :orientation "v" :space-evenly false :spacing 2
        (box :class "ag-group" :space-evenly false :spacing 10
          (label :class "ag-gname" :text "▸ ${g.name}")
          (label :class "muted small" :text {g.path}))
        (for it in {g.items} (agent-row :it it))))
    (label :class "muted small ag-foot" :xalign 0
      :text "j/k waehlen · Enter hinspringen (beendet = fortsetzen) · Esc / Super+c zu")))

; Agenten-Tafel (Super+g): bildschirmfuellend, je laufender Session eine Spalte
; mit dem Chat live (neueste Nachricht unten). Reine Anzeige, kein Klick.
; agents.py chat laeuft nur, solange die Tafel offen ist, und schneidet die
; Nachrichten so zu, dass sie in die Spalte passen.
(deflisten agent_chat :initial `{"cols":[]}` "~/.config/eww/scripts/agents.py chat")

(defwidget chat-col [c]
  (box :class "ch-col ${c.status} ${c.new ? 'new' : ''}" :orientation "v" :space-evenly false :spacing 8
    (box :class "ch-head" :orientation "v" :space-evenly false :spacing 2
      (box :space-evenly false
        (label :class "ag-tool" :hexpand true :xalign 0 :text {c.tool == "claude" ? "λ CLAUDE" : "◆ CODEX"})
        (label :class "ag-status" :text {c.status == "busy" ? "⚙ ARBEITET" : "✓ BEREIT"}))
      (label :class "ag-name" :xalign 0 :limit-width 60 :text {c.name})
      (label :class "ag-meta" :xalign 0
        :text "▸ ${c.group} · ${c.since}${c.tokens != '' ? ' · ' + c.tokens : ''}${c.ws != '' ? ' · ' + c.ws : ''}"))
    (box :orientation "v" :space-evenly false :spacing 6 :vexpand true :valign "end"
      (for m in {c.msgs}
        (box :class "ch-msg ${m.r}" :orientation "v" :space-evenly false
          (label :class "ch-who" :xalign 0 :visible {m.r == "du"} :text "▶ DU")
          (label :class "ch-text" :xalign 0 :wrap true :text {m.r == "tool" ? "› ${m.t}" : m.t}))))))

(defwindow agents-board [w h]  ; agents.py board: Groesse der freien Flaeche des Workspaces
  :monitor "eDP-1"
  :geometry (geometry :anchor "top left" :width w :height h)
  :stacking "overlay"
  :exclusive false
  :focusable false
  (box :class "board" :orientation "v" :space-evenly false :spacing 12
    (box :class "ms-head" :space-evenly false
      (label :class "ms-lambda" :text "λ")
      (box :orientation "v" :space-evenly false :hexpand true
        (label :class "ms-title" :xalign 0 :text "SQUAD STATUS")
        (label :class "muted small" :xalign 0
          :text "${agents.busy} arbeiten · ${agents.idle} bereit · live · Super+g schliesst")))
    (label :class "muted" :visible {arraylength(agent_chat.cols) == 0} :xalign 0 :text "Keine laufenden Agenten.")
    (box :class "ch-cols" :spacing 14 :vexpand true
      (for c in {agent_chat.cols} (chat-col :c c)))))

; Hilfe (Super+Shift+z oder ? neben AMMO): Workspace-Matrix und Shortcuts.
; Statisch — bei neuen Binds oder assigns in sway/config hier nachziehen.
(defwidget ws-cell [ws app]
  (box :class "mx-cell ${app == '' ? '' : 'set'}" :orientation "v" :space-evenly false
    (label :class "mx-ws" :text ws)
    (label :class "mx-app" :visible {app != ""} :text app)))

(defwidget key [k d]
  (box :space-evenly false :spacing 10
    (label :class "key" :xalign 0 :text k)
    (label :class "key-d" :xalign 0 :text d)))

(defwindow info
  :monitor "eDP-1"
  :geometry (geometry :anchor "center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (eventbox :onclick "eww close info"  ; Klick irgendwo aufs Panel schliesst
  (box :class "panel info" :space-evenly false :spacing 28
    (box :orientation "v" :space-evenly false :spacing 4
      (label :class "section" :xalign 0 :text "MONITORE  ·  gleiches Raster auf jedem Schirm")
      (box :class "mx-row" :space-evenly false
        (label :class "mx-nr" :text "")
        (label :class "mx-area" :text "")
        (label :class "mx-head" :text "U  links")
        (label :class "mx-head" :text "I  Mitte")
        (label :class "mx-head" :text "O  Laptop"))
      (box :class "mx-row" :space-evenly false
        (label :class "mx-nr" :text "1")
        (label :class "mx-area" :xalign 0 :text "  Terminal")
        (ws-cell :ws "u1" :app "") (ws-cell :ws "i1" :app "") (ws-cell :ws "o1" :app ""))
      (box :class "mx-row" :space-evenly false
        (label :class "mx-nr" :text "2")
        (label :class "mx-area" :xalign 0 :text "  Browser")
        (ws-cell :ws "u2" :app "") (ws-cell :ws "i2" :app "") (ws-cell :ws "o2" :app ""))
      (box :class "mx-row" :space-evenly false
        (label :class "mx-nr" :text "3")
        (label :class "mx-area" :xalign 0 :text "  Code")
        (ws-cell :ws "u3" :app "") (ws-cell :ws "i3" :app "VS Code") (ws-cell :ws "o3" :app ""))
      (box :class "mx-row" :space-evenly false
        (label :class "mx-nr" :text "4")
        (label :class "mx-area" :xalign 0 :text "  Code 2")
        (ws-cell :ws "u4" :app "") (ws-cell :ws "i4" :app "IntelliJ") (ws-cell :ws "o4" :app ""))
      (box :class "mx-row" :space-evenly false
        (label :class "mx-nr" :text "5")
        (label :class "mx-area" :xalign 0 :text "  Trading")
        (ws-cell :ws "u5" :app "") (ws-cell :ws "i5" :app "") (ws-cell :ws "o5" :app ""))
      (box :class "mx-row" :space-evenly false
        (label :class "mx-nr" :text "6")
        (label :class "mx-area" :xalign 0 :text "  frei")
        (ws-cell :ws "u6" :app "") (ws-cell :ws "i6" :app "") (ws-cell :ws "o6" :app ""))
      (box :class "mx-row" :space-evenly false
        (label :class "mx-nr" :text "7")
        (label :class "mx-area" :xalign 0 :text "  Tools")
        (ws-cell :ws "u7" :app "") (ws-cell :ws "i7" :app "") (ws-cell :ws "o7" :app "KeePassXC"))
      (box :class "mx-row" :space-evenly false
        (label :class "mx-nr" :text "8")
        (label :class "mx-area" :xalign 0 :text "  Todos")
        (ws-cell :ws "u8" :app "") (ws-cell :ws "i8" :app "") (ws-cell :ws "o8" :app "To Do"))
      (box :class "mx-row" :space-evenly false
        (label :class "mx-nr" :text "9")
        (label :class "mx-area" :xalign 0 :text "  Chat")
        (ws-cell :ws "u9" :app "") (ws-cell :ws "i9" :app "") (ws-cell :ws "o9" :app "Teams"))
      (box :class "mx-row" :space-evenly false
        (label :class "mx-nr" :text "0")
        (label :class "mx-area" :xalign 0 :text "  Medien")
        (ws-cell :ws "u10" :app "") (ws-cell :ws "i10" :app "") (ws-cell :ws "o10" :app "YouTube"))
      (label :class "muted small" :xalign 0 :text "Gelb = App landet dort automatisch (assign). Klick schliesst."))
    (box :orientation "v" :space-evenly false :spacing 3
      (label :class "section" :xalign 0 :text "WORKSPACES")
        (key :k "Super+1…0" :d "Workspace N auf diesem Monitor")
        (key :k "Super+Shift+1…0" :d "Fenster dorthin schieben")
        (key :k "Super+Esc" :d "Ziel-Monitor weiter u / i / o (oben → U/I/O, Start o)")
        (key :k "Super+Ctrl+1…0" :d "Workspace N auf dem Ziel-Monitor")
        (key :k "Super+Ctrl+Shift+1…0" :d "Fenster dorthin schieben")
      (label :class "section" :xalign 0 :text "FENSTER")
        (key :k "Super+q / Super+Ctrl+q" :d "naechstes / voriges (Liste links)")
        (key :k "Mausrad kippen → / ←" :d "naechstes / voriges (wie Super+q)")
        (key :k "Super+Mausrad kippen ←" :d "Ziel-Monitor weiter (wie Super+Esc)")
