        (key :k "Super+n / Super+Shift+n" :d "Benachrichtigungen / Nicht stoeren")
        (key :k "Super+Shift+x" :d "sperren")
        (key :k "Super+Shift+e" :d "abmelden")
        (key :k "Super+Shift+c" :d "Sway neu laden")
        (key :k "Super+Shift+s / Super+Ctrl+s" :d "Monitore anordnen / ohne Laptop")
        (key :k "Print, Ctrl+Print" :d "Screenshot, in Zwischenablage")
